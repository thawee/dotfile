Table CIF {
  ACN bigint [pk, note: 'Customer Number']
  NAM varchar(180) [note: 'Customer Name']
  FNAME varchar(120) [note: 'First Name']
  LNM varchar(120) [note: 'Last Name']
  DOB date [note: 'Date of Birth']
  DAO date [note: 'Date Account Opened']
  EMAIL varchar(55) [note: 'Electronic Mail']
  HPH varchar(12) [note: 'Home Phone']
  BPH varchar(12) [note: 'Business Phone']
  BOO int [note: 'Branch of Ownership']
  CC int [note: 'Cost Center']
  CRCD varchar(3) [note: 'Currency Code']
  GRP varchar(4) [note: 'Account Group']
  CIFOFF varchar(20) [note: 'Officer Code']
  ALERT boolean [note: 'Eligible for Alerts']
}

Table ACN {
  CID bigint [pk, note: 'Account Number']
  ACN bigint [note: 'Customer Number']
  ACCTNAME varchar(25) [note: 'Account Name']
  DAO date [note: 'Date Account Opened']
  DTC date [note: 'Date Account Closed']
  BAL decimal(15,2) [note: 'Ledger Balance']
  BALAVAIL decimal(18,2) [note: 'Available Balance']
  BOO int [note: 'Branch of Ownership']
  CRCD varchar(3) [note: 'Currency Code']
  GRP varchar(4) [note: 'Product Group']
  CLS varchar(1) [note: 'Product Class']
  CC int [note: 'Cost Center']
  CHKS varchar(6) [note: 'Check Type']
  COMM boolean [note: 'Commercial Account Flag']
}

Table DEP {
  CID bigint [pk, note: 'Account Number']
  BALAVL decimal(15,2) [note: 'Available Balance']
  ACR decimal(15,5) [note: 'Accrued Interest/Dividend']
  INP date [note: 'Interest Next Posting Date']
  IPF varchar(12) [note: 'Interest Posting Frequency']
  IPLD date [note: 'Interest Last Posting Date']
  BWF boolean [note: 'Backup Withholding']
  CO varchar(12) [note: 'Company Code']
  CUMDEP boolean [note: 'Cumulative Deposit']
  AREF bigint [note: 'Loan Account Number']
}

Table LN {
  CID bigint [pk, note: 'Account Number']
  BALCMP decimal(15,2) [note: 'Balance (Computed)']
  ACR decimal(15,5) [note: 'Accrued Interest']
  PMTPI decimal(12,2) [note: 'Principal and Interest Payment']
  MDT date [note: 'Account Maturity Date']
  TRM varchar(8) [note: 'Account Term']
  PTRM varchar(8) [note: 'Payment Term']
  IRN decimal(8,5) [note: 'Nominal Interest Rate']
  INDEX varchar(20) [note: 'Interest Index']
  INTFRE varchar(12) [note: 'Interest Change Frequency']
  AUPTCID bigint [note: 'Automatic Loan Payment Account']
}

Table ACNADDR {
  CID bigint [pk, note: 'Account Number']
  ACN bigint [note: 'Customer Number']
  AD1 varchar(150)
  AD2 varchar(150)
  AD3 varchar(150)
  AD4 varchar(150)
  CITY varchar(40)
  STATE varchar(2)
  CNTRY varchar(2)
  MZIP varchar(10)
}

Table CIFSERV {
  ACN bigint [note: 'Customer Number']
  SRVCAT varchar(20) [note: 'Service Category']
  SERVICE varchar(12) [note: 'Service Name']
  USERID1 varchar(32) [note: 'User Identifier for Service']
  STATUS int [note: 'Customer Status - Service']

  indexes {
    (ACN, SRVCAT, SERVICE) [pk, name: 'pk_cifserv']
  }
}

Table CIFACCTS {
  ACN bigint [note: 'Customer Number']
  SRVCAT varchar(12) [note: 'Service Category']
  SERVICE varchar(20) [note: 'Service Name']
  ACCKEY varchar(40) [note: 'Composite Access Key']
  IDENTIFIER varchar(25) [note: 'Account Identifier']
  USERID1 varchar(32) [note: 'Account User ID']
  STATUS int [note: 'Account Status']
  ACCENDT date [note: 'Account Enrollment Date']
  CRCD varchar(3)

  indexes {
    (ACN, SRVCAT, SERVICE, ACCKEY) [pk, name: 'pk_cifaccts']
  }
}

Table ACNSEG {
