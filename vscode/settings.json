{
  "github.copilot.nextEditSuggestions.enabled": true,
  "terminal.integrated.commandsToSkipShell": [
    "psl.stepIn",
    "psl.stepOut",
    "psl.stepOver",
    "psl.sendToHostTerminal"
  ],
  "projectManager.git.baseFolders": [
    "/Users/thawee.p/Workspaces/CodeRepos",
    "/Users/thawee.p/Workspaces/Labs",
    "/Users/thawee.p/Workspaces/PRF-Tools"
  ],
  "git.ignoreMissingGitWarning": true,
  "http.proxyStrictSSL": false,
  "editor.fontFamily": "'MonoLisa Nerd Font', MonoLisa, 'JetBrains Mono', 'Fira Code', Menlo, Monaco, 'Courier New', monospace",
  "editor.fontSize": 14,
  "editor.fontWeight": "normal",
  "editor.lineHeight": 1.6,
  "editor.fontLigatures": true,
  "editor.cursorBlinking": "solid",
  "editor.cursorStyle": "line",
  "editor.smoothScrolling": true,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.tabSize": 2,
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.editor.limit.enabled": false,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  "editor.renderWhitespace": "boundary",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.minimap.enabled": true,
  "editor.minimap.renderCharacters": false,
  "editor.stickyScroll.enabled": true,
  "editor.inlineSuggest.enabled": true,
  "editor.suggest.preview": true,
  "editor.wordWrap": "off",
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "workbench.tree.indent": 16,
  "workbench.startupEditor": "none",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.compactFolders": false,
  "security.workspace.trust.untrustedFiles": "open",
  "terminal.integrated.fontFamily": "'MonoLisa Nerd Font', MonoLisa, 'Symbols Nerd Font Mono', 'JetBrains Mono', 'Fira Code Retina', Menlo, Monaco, 'Courier New', monospace",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.letterSpacing": 0,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.cursorBlinking": false,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.minimumContrastRatio": 1,
  "diffEditor.codeLens": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "json": false
  },
  "chat.viewSessions.enabled": false,
  "workbench.colorTheme": "Islands Dark",
  "chat.mcp.gallery.enabled": true,
  "extensions.ignoreRecommendations": true,
  "mermaidLivePreview.useVSCodeTheme": false,
  "mermaidLivePreview.theme": "default",
  "custom-ui-style.electron": {
    "frame": true
  },
  "custom-ui-style.external.imports": [
    "file://${userHome}/.vscode/neon.css"
  ]
}
